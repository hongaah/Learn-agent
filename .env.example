# 请求发去哪个地址。留空走 Anthropic 官方；
# 用第三方 Anthropic 兼容端点时填对方给的地址。
ANTHROPIC_BASE_URL=

# 鉴权用的 key。官方和第三方端点各发各的，不能混用。
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# 调用哪个模型。代码里从不写死，只读这个变量。
# 官方端点可用：claude-opus-5 / claude-sonnet-4-6 / claude-haiku-4-5
# 第三方端点：填对方支持的模型名
MODEL_ID=claude-opus-5

# 提示：Bun 会自动加载本文件，不需要 dotenv。
